# No MongoDB connection is used by this service.
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/campusflow_ops
DATABASE_USERNAME=campusflow
DATABASE_PASSWORD=replace-with-local-password
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
DEMO_ENABLED=true
# Optional: use a dedicated test calendar and a token with calendar.events access.
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_ACCESS_TOKEN=
